# ==========================================
# مأوى العقارية | MAWAA REAL ESTATE
# Environment Configuration
# ==========================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (Public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional: Supabase Service Role Key (Server-side administration only, never exposed to client)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site URL for canonical URLs and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
